[Unit]
Description=xWalk hardware GitHub Actions runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/github-actions-runner-xwalk-hw
EnvironmentFile=%h/apps/github-actions-runner-xwalk-hw/.env
ExecStart=%h/apps/github-actions-runner-xwalk-hw/run.sh
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=5min

[Install]
WantedBy=default.target
