#!/usr/bin/env python3
"""Reject callable expressions embedded in project C++ decision conditions."""

from __future__ import annotations

import argparse
from pathlib import Path
import re
import sys


CPP_EXTENSIONS = {".cc", ".cpp", ".cxx", ".h", ".hpp", ".hxx"}
EXCLUDED_DIRECTORIES = {
    ".git",
    "Build",
    "auto-gen",
    "build",
    "external",
    "generated",
    "third_party",
    "vendor",
    "x86_64",
    "aarch64",
}
CONTROL_PATTERN = re.compile(r"\b(if|while)\s*\(")
CALL_PATTERN = re.compile(
    r"(?:::)?[A-Za-z_]\w*(?:(?:::|\.|->)[A-Za-z_]\w*)*\s*\("
)
LITERAL_PATTERN = re.compile(
    r"//[^\n]*|/\*.*?\*/|\"(?:\\.|[^\"\\])*\"|'(?:\\.|[^'\\])*'",
    re.DOTALL,
)
NON_CALL_KEYWORDS = {
    "alignof",
    "catch",
    "const_cast",
    "decltype",
    "defined",
    "dynamic_cast",
    "for",
    "if",
    "noexcept",
    "reinterpret_cast",
    "sizeof",
    "static_cast",
    "switch",
    "typeid",
    "while",
}


def excluded(path: Path) -> bool:
    """Report whether a project-owned source path is outside audit scope."""

    return any(
        part in EXCLUDED_DIRECTORIES
        or part.startswith("build-")
        or part.startswith("cmake-build-")
        for part in path.parts
    )


def condition_end(source: str, start: int) -> int | None:
    """Find the closing parenthesis for one condition without parsing literals."""

    depth = 0
    quote: str | None = None
    escaped = False
    line_comment = False
    block_comment = False
    index = start
    while index < len(source):
        character = source[index]
        pair = source[index : index + 2]
        if line_comment:
            line_comment = character != "\n"
        elif block_comment:
            if pair == "*/":
                block_comment = False
                index += 1
        elif quote is not None:
            if escaped:
                escaped = False
            elif character == "\\":
                escaped = True
            elif character == quote:
                quote = None
        elif pair == "//":
            line_comment = True
            index += 1
        elif pair == "/*":
            block_comment = True
            index += 1
        elif character in {'"', "'"}:
            quote = character
        elif character == "(":
            depth += 1
        elif character == ")":
            depth -= 1
            if depth == 0:
                return index
        index += 1
    return None


def callable_names(condition: str) -> list[str]:
    """Return callable or function-like macro names from one condition."""

    cleaned = LITERAL_PATTERN.sub(" ", condition)
    names: list[str] = []
    for token in CALL_PATTERN.findall(cleaned):
        name = re.split(r"::|\.|->", token[:-1].strip())[-1]
        if name not in NON_CALL_KEYWORDS:
            names.append(name)
    return names


def violations(path: Path) -> list[str]:
    """Return formatted decision-condition violations from one source file."""

    source = path.read_text(encoding="utf-8", errors="replace")
    results: list[str] = []
    for match in CONTROL_PATTERN.finditer(source):
        start = source.find("(", match.start())
        end = condition_end(source, start)
        if end is None:
            continue
        names = callable_names(source[start + 1 : end])
        if names:
            line = source.count("\n", 0, match.start()) + 1
            results.append(
                f"{path}:{line}: {match.group(1)} condition invokes {', '.join(names)}"
            )
    return results


def source_files(root: Path) -> list[Path]:
    """Discover project-owned C++ source and header files."""

    return sorted(
        path
        for path in root.rglob("*")
        if path.is_file() and path.suffix in CPP_EXTENSIONS and not excluded(path)
    )


def main() -> int:
    """Audit one source tree and return nonzero when violations exist."""

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("root", nargs="?", default="xWalk-rpi5-hw")
    arguments = parser.parse_args()
    root = Path(arguments.root).resolve()
    if not root.is_dir():
        print(f"Condition check root is not a directory: {root}", file=sys.stderr)
        return 2
    results: list[str] = []
    files = source_files(root)
    for path in files:
        results.extend(violations(path))
    for result in results:
        print(result)
    print(f"Condition check: files={len(files)} violations={len(results)}")
    return 1 if results else 0


if __name__ == "__main__":
    raise SystemExit(main())
