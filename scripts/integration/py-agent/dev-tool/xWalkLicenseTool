#!/usr/bin/env python3
"""Encrypt and decrypt xWalk model settings with authenticated encryption."""

from __future__ import annotations

import argparse
import configparser
import datetime
import getpass
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path
from typing import Sequence

from nacl.exceptions import CryptoError
from nacl.secret import SecretBox


class XWalkLicenseError(Exception):
    """Report a safe, user-facing licence workflow failure."""


def default_project_root() -> Path:
    """Locate the integrated workspace without assuming a tool-directory depth."""

    script_path = Path(__file__).resolve()
    result = subprocess.run(
        ["git", "-C", str(script_path.parent), "rev-parse", "--show-toplevel"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode == 0:
        git_root = Path(result.stdout.strip()).resolve()
        if (git_root / "xWalk-rpi5-hw").is_dir():
            return git_root
    if script_path.parents[2].name == "integration":
        return script_path.parents[4]
    return script_path.parents[3]


@dataclass(frozen=True)
class XWalkEncryptionResult:
    """Return non-plaintext metadata only after encrypted output is durable."""

    serial_number: str
    decryption_key: str


class XWalkLicenseTool:
    """Protect xWalk model settings in the project licence file."""

    MAGIC_HEADER = b"XWL1"
    SERIAL_VARIABLE_NAME = "X_WALK_LICENSE_SERIAL"
    ENVIRONMENT_NAME_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
    CREDENTIAL_NAME_PATTERN = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*_API_KEY$")
    SERIAL_NUMBER_PATTERN = re.compile(r"^XWALK-[0-9]{4}-[0-9A-F]{8}$")

    def __init__(self, project_root: Path | None = None) -> None:
        """Locate the project and its fixed encrypted licence output path."""
        self.project_root = (
            project_root.resolve()
            if project_root is not None
            else default_project_root()
        )
        self.license_path = (
            self.project_root / "xWalk-rpi5-hw" / "xWalkLibrary" / "X_WALK_LICENSE.KEY"
        )

    @classmethod
    def validate_variables(cls, variables: object) -> dict[str, str]:
        """Validate a model-variable mapping without revealing values."""
        if not isinstance(variables, dict):
            raise XWalkLicenseError("The model configuration must contain a mapping.")
        if not variables:
            raise XWalkLicenseError("Cannot encrypt: no model variables were provided.")

        validated: dict[str, str] = {}
        credential_names: list[str] = []
        empty_names: list[str] = []
        unsupported_names: list[str] = []
        for name, value in variables.items():
            if not isinstance(name, str) or not cls.ENVIRONMENT_NAME_PATTERN.fullmatch(name):
                raise XWalkLicenseError("An invalid environment-variable name was provided.")
            if not isinstance(value, str):
                raise XWalkLicenseError(
                    f"Cannot encrypt: {name} must have a string value."
                )
            if cls.CREDENTIAL_NAME_PATTERN.fullmatch(name):
                credential_names.append(name)
            if not value:
                empty_names.append(name)
            if "\0" in value:
                unsupported_names.append(name)
            validated[name] = value

        if credential_names:
            joined_names = cls._join_names(sorted(credential_names))
            raise XWalkLicenseError(
                f"Credential variables are not supported in licence payloads: store {joined_names} in ~/.netrc."
            )
        if empty_names:
            joined_names = cls._join_names(sorted(empty_names))
            raise XWalkLicenseError(
                f"Cannot encrypt: {joined_names} contain empty values."
            )
        if unsupported_names:
            joined_names = cls._join_names(sorted(unsupported_names))
            raise XWalkLicenseError(
                f"Cannot encrypt: {joined_names} contain unsupported null bytes."
            )
        return validated

    @classmethod
    def load_config_variables(cls, path: Path) -> dict[str, str]:
        """Load and validate variables from one protected INI-style configuration file."""
        parser = configparser.ConfigParser(interpolation=None, strict=True)
        parser.optionxform = str
        try:
            with path.open("r", encoding="utf-8") as input_file:
                parser.read_file(input_file)
        except configparser.Error as error:
            raise XWalkLicenseError("Cannot encrypt: the configuration input is malformed.") from error
        except OSError as error:
            raise XWalkLicenseError(f"Cannot read the configuration input: {error.strerror}.") from error
        if parser.defaults() or parser.sections() != ["models"]:
            raise XWalkLicenseError(
                "Cannot encrypt: the configuration must contain only one [models] section."
            )
        variables = dict(parser.items("models", raw=True))
        return cls.validate_variables(variables)

    @classmethod
    def load_environment_arguments(cls, entries: Sequence[str]) -> dict[str, str]:
        """Load and validate repeated NAME=VALUE command-line entries."""
        if not entries:
            raise XWalkLicenseError("Cannot encrypt: no model variables were provided.")

        variables: dict[str, str] = {}
        for entry in entries:
            if "=" not in entry:
                raise XWalkLicenseError("Each --env argument must use NAME=VALUE format.")
            name, value = entry.split("=", 1)
            if not cls.ENVIRONMENT_NAME_PATTERN.fullmatch(name):
                raise XWalkLicenseError("An invalid environment-variable name was provided.")
            if name in variables:
                raise XWalkLicenseError(
                    f"Cannot encrypt: duplicate --env variable name {name}."
                )
            variables[name] = value
        return cls.validate_variables(variables)

    def encrypt(self, variables: dict[str, str]) -> XWalkEncryptionResult:
        """Write encrypted variables before returning their serial and decryption key."""
        validated = self.validate_variables(variables)
        if self.SERIAL_VARIABLE_NAME in validated:
            raise XWalkLicenseError(
                f"Cannot encrypt: {self.SERIAL_VARIABLE_NAME} is generated automatically."
            )
        serial_number = self._generate_serial_number()
        payload = dict(validated)
        payload[self.SERIAL_VARIABLE_NAME] = serial_number
        plaintext = json.dumps(
            payload, sort_keys=True, separators=(",", ":")
        ).encode("utf-8")
        key = secrets.token_bytes(SecretBox.KEY_SIZE)
        encrypted = SecretBox(key).encrypt(plaintext)
        self._write_private_file(self.license_path, self.MAGIC_HEADER + bytes(encrypted))
        return XWalkEncryptionResult(serial_number, key.hex())

    def decrypt(self, key_text: str, output_path: Path) -> dict[str, str]:
        """Authenticate, decrypt, validate, and privately write one JSON output file."""
        key = self._parse_key(key_text)
        try:
            encrypted = self.license_path.read_bytes()
        except OSError as error:
            raise XWalkLicenseError(
                f"Cannot read encrypted licence file: {error.strerror}."
            ) from error
        if not encrypted.startswith(self.MAGIC_HEADER):
            raise XWalkLicenseError("Unsupported or invalid encrypted licence header.")
        if len(encrypted) <= len(self.MAGIC_HEADER) + SecretBox.NONCE_SIZE:
            raise XWalkLicenseError("The encrypted licence file is incomplete.")

        try:
            plaintext = SecretBox(key).decrypt(encrypted[len(self.MAGIC_HEADER) :])
        except CryptoError as error:
            raise XWalkLicenseError(
                "Decryption failed: the key is incorrect or the encrypted file was modified."
            ) from error

        try:
            variables = json.loads(plaintext.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise XWalkLicenseError("The decrypted licence payload is invalid.") from error
        validated = self.validate_variables(variables)
        serial_number = validated.get(self.SERIAL_VARIABLE_NAME)
        if serial_number is None or not self.SERIAL_NUMBER_PATTERN.fullmatch(serial_number):
            raise XWalkLicenseError("The decrypted licence serial number is invalid.")
        output = json.dumps(validated, indent=4, sort_keys=True) + "\n"
        self._write_private_file(output_path.resolve(), output.encode("utf-8"))
        return validated

    @staticmethod
    def _generate_serial_number() -> str:
        """Generate one public identifier from the UTC year and secure randomness."""
        current_year = datetime.datetime.now(datetime.timezone.utc).year
        random_portion = secrets.token_hex(4).upper()
        return f"XWALK-{current_year}-{random_portion}"

    @staticmethod
    def _parse_key(key_text: str) -> bytes:
        """Parse the displayed 256-bit hexadecimal key without logging it."""
        try:
            key = bytes.fromhex(key_text.strip())
        except ValueError as error:
            raise XWalkLicenseError(
                "The decryption key must be the generated hexadecimal key."
            ) from error
        if len(key) != SecretBox.KEY_SIZE:
            raise XWalkLicenseError("The decryption key must contain exactly 256 bits.")
        return key

    @staticmethod
    def _write_private_file(path: Path, content: bytes) -> None:
        """Atomically replace a file with owner-only permissions."""
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary_path: str | None = None
        try:
            descriptor, temporary_path = tempfile.mkstemp(
                prefix=f".{path.name}.", dir=path.parent
            )
            os.fchmod(descriptor, 0o600)
            with os.fdopen(descriptor, "wb") as output_file:
                output_file.write(content)
                output_file.flush()
                os.fsync(output_file.fileno())
            os.replace(temporary_path, path)
            temporary_path = None
        except OSError as error:
            raise XWalkLicenseError(f"Cannot write output file: {error.strerror}.") from error
        finally:
            if temporary_path is not None:
                try:
                    os.unlink(temporary_path)
                except FileNotFoundError:
                    pass

    @staticmethod
    def _join_names(names: Sequence[str]) -> str:
        """Format variable names without inspecting or displaying their values."""
        if len(names) == 1:
            return names[0]
        if len(names) == 2:
            return f"{names[0]} and {names[1]}"
        return f"{', '.join(names[:-1])}, and {names[-1]}"


def create_argument_parser() -> argparse.ArgumentParser:
    """Create the licence-tool command-line parser."""
    parser = argparse.ArgumentParser(
        description="Encrypt or decrypt the xWalk model-selection licence file."
    )
    commands = parser.add_subparsers(dest="command", required=True)

    encrypt_parser = commands.add_parser("encrypt", help="encrypt model variables")
    input_group = encrypt_parser.add_mutually_exclusive_group(required=True)
    input_group.add_argument("--config", type=Path, help="protected model configuration input file")
    input_group.add_argument(
        "--env",
        action="append",
        metavar="NAME=VALUE",
        help="model environment variable; repeat for additional values",
    )

    decrypt_parser = commands.add_parser("decrypt", help="decrypt to a private JSON file")
    decrypt_parser.add_argument("--output", type=Path, required=True)
    return parser


def main(arguments: Sequence[str] | None = None) -> int:
    """Run one command and convert expected failures into a nonzero exit code."""
    parser = create_argument_parser()
    options = parser.parse_args(arguments)
    tool = XWalkLicenseTool()
    try:
        if options.command == "encrypt":
            variables = (
                tool.load_config_variables(options.config)
                if options.config is not None
                else tool.load_environment_arguments(options.env)
            )
            result = tool.encrypt(variables)
            print("xWalk licence created successfully.")
            print()
            print("Encrypted licence file:")
            print(tool.license_path)
            print()
            print("Licence serial number:")
            print(result.serial_number)
            print()
            print("Decryption key:")
            print(result.decryption_key)
        else:
            key_text = getpass.getpass("Decryption key: ")
            variables = tool.decrypt(key_text, options.output)
            names = sorted(variables)
            print(f"Processed {len(names)} variables: {', '.join(names)}")
            print(f"Decrypted JSON written to {options.output.resolve()}")
    except XWalkLicenseError as error:
        print(f"Error: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
