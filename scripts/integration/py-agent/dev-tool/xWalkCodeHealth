#!/usr/bin/env python3
"""Run a policy-controlled CodeScene CLI delta analysis for xWalk CI."""

from __future__ import annotations

import argparse
import fnmatch
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
from typing import Any
from urllib.parse import urlparse


class XWalkCodeHealthError(Exception):
    """Report invalid repository configuration or revision metadata."""


SECRET_ASSIGNMENT = re.compile(
    r"(?i)\b([A-Z0-9_]*(?:PASSWORD|TOKEN|SECRET|PRIVATE_KEY|AUTHORIZATION|COOKIE)[A-Z0-9_]*)=([^\s]+)"
)
AUTHENTICATED_URL = re.compile(r"(https?://)[^/@\s:]+:[^/@\s]+@")
PRIVATE_KEY = re.compile(
    r"-----BEGIN [^-]*PRIVATE KEY-----.*?-----END [^-]*PRIVATE KEY-----", re.DOTALL,
)


def redact(value: str) -> str:
    """Remove common credential forms before retaining CLI diagnostics."""

    value = PRIVATE_KEY.sub("[REDACTED PRIVATE KEY]", value)
    value = AUTHENTICATED_URL.sub(r"\1[REDACTED]@", value)
    return SECRET_ASSIGNMENT.sub(r"\1=[REDACTED]", value)


def repository_root() -> Path:
    """Return the enclosing MyPiCarX Git worktree root."""

    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], check=False, capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise XWalkCodeHealthError("Code Health must run inside a Git worktree")
    return Path(result.stdout.strip()).resolve()


def load_configuration(root: Path) -> dict[str, Any]:
    """Load and validate the repository-owned CodeScene project mapping."""

    path = root / ".codescene/project.json"
    try:
        configuration = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise XWalkCodeHealthError(f"cannot read {path}: {error}") from error
    if not isinstance(configuration, dict) or configuration.get("schema_version") != 1:
        raise XWalkCodeHealthError("unsupported .codescene/project.json schema")
    if configuration.get("repository") != "MyPiCarX":
        raise XWalkCodeHealthError("CodeScene must analyze only the MyPiCarX repository")
    source_root = configuration.get("source_root")
    if not isinstance(source_root, str) or not (root / source_root).is_dir():
        raise XWalkCodeHealthError("CodeScene source_root does not exist")

    components = configuration.get("components")
    if not isinstance(components, list) or len(components) != 8:
        raise XWalkCodeHealthError("CodeScene requires exactly eight architectural components")
    names: set[str] = set()
    patterns: set[str] = set()
    for component in components:
        if not isinstance(component, dict) or not isinstance(component.get("name"), str):
            raise XWalkCodeHealthError("every CodeScene component requires a name")
        component_patterns = component.get("patterns")
        if not isinstance(component_patterns, list) or not component_patterns:
            raise XWalkCodeHealthError("every CodeScene component requires patterns")
        if not all(isinstance(pattern, str) and pattern for pattern in component_patterns):
            raise XWalkCodeHealthError("CodeScene component patterns must be non-empty strings")
        names.add(component["name"])
        patterns.update(component_patterns)
    if len(names) != len(components) or len(patterns) != len(components):
        raise XWalkCodeHealthError("CodeScene component names and patterns must be unique")
    for pattern in patterns:
        component_path = pattern.removesuffix("/**")
        if not (root / component_path).is_dir():
            raise XWalkCodeHealthError(f"CodeScene component path does not exist: {pattern}")

    exclusions = configuration.get("exclusions")
    if not isinstance(exclusions, list) or not all(
        isinstance(pattern, str) and pattern for pattern in exclusions
    ):
        raise XWalkCodeHealthError("CodeScene exclusions must be non-empty strings")
    unsafe_exclusions = {
        "**/test/**", "**/tests/**", "**/HostTest/**", "**/include/**", "**/src/**",
    }
    if unsafe_exclusions.intersection(exclusions):
        raise XWalkCodeHealthError("CodeScene exclusions must retain source, headers, and tests")

    components_path = root / ".codescene/architectural-components.json"
    exclusions_path = root / ".codescene/analysis-exclusions.txt"
    try:
        api_components = json.loads(components_path.read_text(encoding="utf-8"))
        configured_exclusions = [
            line for line in exclusions_path.read_text(encoding="utf-8").splitlines()
            if line
        ]
    except (OSError, json.JSONDecodeError) as error:
        raise XWalkCodeHealthError(f"cannot read CodeScene deployment manifests: {error}") from error
    if api_components != components:
        raise XWalkCodeHealthError("architectural-components.json differs from project.json")
    if configured_exclusions != exclusions:
        raise XWalkCodeHealthError("analysis-exclusions.txt differs from project.json")
    return configuration


def git_output(root: Path, *arguments: str) -> str:
    """Run one read-only Git command and return its stripped output."""

    result = subprocess.run(
        ["git", *arguments], cwd=root, check=False, capture_output=True, text=True,
    )
    if result.returncode != 0:
        raise XWalkCodeHealthError(
            f"git {' '.join(arguments)} failed; verify full history and revision metadata"
        )
    return result.stdout.strip()


def resolve_revision(root: Path, value: str, fallback: str) -> str:
    """Resolve one requested revision or a safe local fallback to a full commit ID."""

    requested = value.strip()
    if not requested or set(requested) == {"0"}:
        requested = fallback
    return git_output(root, "rev-parse", "--verify", f"{requested}^{{commit}}")


def changed_files(root: Path, baseline: str, revision: str) -> list[str]:
    """Return files changed between the exact baseline and reviewed revision."""

    output = git_output(
        root, "diff", "--name-only", "--diff-filter=ACMRTUXB", baseline, revision, "--",
    )
    return [line for line in output.splitlines() if line]


def matching_component(path: str, configuration: dict[str, Any]) -> str | None:
    """Return the configured architectural component for one repository path."""

    for component in configuration["components"]:
        if any(fnmatch.fnmatch(path, pattern) for pattern in component["patterns"]):
            return str(component["name"])
    return None


def is_excluded(path: str, configuration: dict[str, Any]) -> bool:
    """Report whether one path matches an approved generated/output exclusion."""

    return any(fnmatch.fnmatch(path, pattern) for pattern in configuration["exclusions"])


def find_value(value: object, keys: set[str]) -> object | None:
    """Find the first exact key recursively in a CodeScene JSON result."""

    if isinstance(value, dict):
        for key, item in value.items():
            if key in keys:
                return item
            found = find_value(item, keys)
            if found is not None:
                return found
    elif isinstance(value, list):
        for item in value:
            found = find_value(item, keys)
            if found is not None:
                return found
    return None


def analysis_link(value: object) -> str | None:
    """Return a CodeScene HTTP analysis link when the CLI result supplies one."""

    candidate = find_value(value, {"view", "url"})
    if not isinstance(candidate, str):
        return None
    parsed = urlparse(candidate)
    return candidate if parsed.scheme in {"http", "https"} and parsed.netloc else None


def write_summary(path: Path, summary: dict[str, Any]) -> None:
    """Write deterministic JSON and an optional GitHub job summary."""

    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    github_summary = os.environ.get("GITHUB_STEP_SUMMARY", "")
    if not github_summary:
        return
    changed_count = summary["changed_files_analysed"]
    if changed_count is None:
        changed_count = "unavailable"
    lines = [
        "## MyPiCarX / Code Health", "",
        f"- Status: `{summary['status']}`",
        f"- Quality gate: `{summary['quality_gate']}`",
        f"- Code-health degradation: `{summary['code_health_degradation']}`",
        f"- Changed files analysed: `{changed_count}`",
        f"- Revision: `{summary['revision']}`",
        f"- Policy: `{'strict' if summary['strict'] else 'non-blocking'}`",
    ]
    if summary.get("analysis_link"):
        lines.append(f"- Analysis: {summary['analysis_link']}")
    if summary.get("reason"):
        lines.append(f"- Diagnostic: {summary['reason']}")
    with Path(github_summary).open("a", encoding="utf-8") as output:
        output.write("\n".join(lines) + "\n")


def strict_policy() -> bool:
    """Return whether unavailable or failing CodeScene analysis blocks CI."""

    value = os.environ.get("XWALK_CODESCENE_STRICT", "false").casefold()
    if value not in {"true", "false"}:
        raise XWalkCodeHealthError("XWALK_CODESCENE_STRICT must be true or false")
    return value == "true"


def configured_cli() -> str | None:
    """Resolve the administrator-installed CodeScene CLI without downloading software."""

    configured = os.environ.get("XWALK_CODESCENE_CLI", "cs").strip()
    if not configured:
        return None
    if "/" in configured:
        path = Path(configured).expanduser()
        return str(path.resolve()) if path.is_file() and os.access(path, os.X_OK) else None
    executable = shutil.which(configured)
    if executable is not None:
        return executable
    official_path = Path.home() / ".local" / "bin" / configured
    return (
        str(official_path.resolve())
        if official_path.is_file() and os.access(official_path, os.X_OK)
        else None
    )


def activation_available() -> bool:
    """Return whether the licensed CodeScene CLI access token is configured."""

    return bool(os.environ.get("CS_ACCESS_TOKEN", "").strip())


def correlation() -> dict[str, str]:
    """Return non-secret Gerrit and GitHub identifiers supplied by CI."""

    names = (
        "GERRIT_CHANGE_NUMBER", "GERRIT_PATCHSET_NUMBER", "GERRIT_PATCHSET_REVISION",
        "GERRIT_REFSPEC", "GERRIT_PROJECT", "GERRIT_BRANCH", "GITHUB_SHA",
        "GITHUB_HEAD_SHA", "GITHUB_BASE_SHA",
    )
    return {name: os.environ[name] for name in names if os.environ.get(name)}


def analyze(root: Path, configuration: dict[str, Any]) -> int:
    """Run an exact CodeScene delta when the licensed CLI is available."""

    output_directory = root / os.environ.get(
        "XWALK_CODESCENE_REPORT_DIRECTORY", "build-host/codescene"
    )
    output_directory.mkdir(parents=True, exist_ok=True)
    strict = strict_policy()
    unavailable_reason = os.environ.get("XWALK_CODESCENE_UNAVAILABLE_REASON", "").strip()
    if unavailable_reason:
        summary = {
            "analysis_link": None,
            "baseline": "",
            "changed_files": [],
            "changed_files_analysed": None,
            "code_health_degradation": "UNKNOWN",
            "components": [],
            "correlation": correlation(),
            "quality_gate": "UNAVAILABLE",
            "reason": redact(unavailable_reason),
            "repository": configuration["repository"],
            "revision": os.environ.get("GERRIT_PATCHSET_REVISION", ""),
            "status": "UNAVAILABLE",
            "strict": strict,
        }
        write_summary(output_directory / "summary.json", summary)
        print(f"CodeScene Code Health: UNAVAILABLE - {summary['reason']}")
        return 1 if strict else 0
    revision = resolve_revision(
        root,
        os.environ.get("XWALK_CODESCENE_REVISION", ""),
        "HEAD",
    )
    baseline = resolve_revision(
        root,
        os.environ.get("XWALK_CODESCENE_BASE_REVISION", ""),
        f"{revision}^",
    )
    files = changed_files(root, baseline, revision)
    analysed = [
        path for path in files
        if matching_component(path, configuration) is not None
        and not is_excluded(path, configuration)
    ]
    components = sorted({
        component for path in analysed
        if (component := matching_component(path, configuration)) is not None
    })
    summary: dict[str, Any] = {
        "analysis_link": None,
        "baseline": baseline,
        "changed_files": files,
        "changed_files_analysed": len(analysed),
        "code_health_degradation": "UNKNOWN",
        "components": components,
        "correlation": correlation(),
        "quality_gate": "UNAVAILABLE",
        "reason": "",
        "repository": configuration["repository"],
        "revision": revision,
        "status": "UNAVAILABLE",
        "strict": strict,
    }
    if not analysed:
        summary.update({
            "code_health_degradation": "NO",
            "quality_gate": "PASSED",
            "reason": (
                "No changed files belong to a configured architectural component after "
                "approved output/generated exclusions."
            ),
            "status": "PASSED",
        })
        write_summary(output_directory / "summary.json", summary)
        print("CodeScene Code Health: PASSED - no eligible changed files")
        return 0

    cli = configured_cli()
    if cli is None:
        summary["reason"] = (
            "CodeScene CLI executable is unavailable. Install the licensed CLI at its official "
            "~/.local/bin/cs location or set XWALK_CODESCENE_CLI to its executable."
        )
        write_summary(output_directory / "summary.json", summary)
        print(f"CodeScene Code Health: UNAVAILABLE - {summary['reason']}")
        return 1 if strict else 0
    if not activation_available():
        summary["reason"] = (
            "CodeScene CLI activation is unavailable. Configure CS_ACCESS_TOKEN in the "
            "mode-0600 CI environment and CS_ONPREM_URL when using CodeScene Enterprise."
        )
        write_summary(output_directory / "summary.json", summary)
        print(f"CodeScene Code Health: UNAVAILABLE - {summary['reason']}")
        return 1 if strict else 0

    timeout_seconds = int(os.environ.get("XWALK_CODESCENE_TIMEOUT_SECONDS", "900"))
    if timeout_seconds < 1 or timeout_seconds > 3600:
        raise XWalkCodeHealthError("XWALK_CODESCENE_TIMEOUT_SECONDS must be between 1 and 3600")
    try:
        result = subprocess.run(
            [cli, "delta", "--output-format", "json", baseline, revision],
            cwd=root, check=False, capture_output=True, text=True, timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired:
        summary["reason"] = f"CodeScene CLI exceeded the {timeout_seconds}-second timeout."
        write_summary(output_directory / "summary.json", summary)
        print(f"CodeScene Code Health: UNAVAILABLE - {summary['reason']}")
        return 1 if strict else 0

    raw_output = redact(result.stdout)
    diagnostic_lines = [
        f"exit_code={result.returncode}",
        f"stdout_bytes={len(result.stdout.encode('utf-8'))}",
        f"stderr_bytes={len(result.stderr.encode('utf-8'))}",
    ]
    if result.stderr:
        diagnostic_lines.extend(("", redact(result.stderr).rstrip()))
    (output_directory / "diagnostic.txt").write_text(
        "\n".join(diagnostic_lines).rstrip() + "\n", encoding="utf-8"
    )
    (output_directory / "delta-analysis.json").write_text(raw_output, encoding="utf-8")
    if result.returncode == 0 and not raw_output.strip():
        summary.update({
            "code_health_degradation": "NO",
            "quality_gate": "PASSED",
            "reason": "CodeScene CLI delta analysis completed with no new findings.",
            "status": "PASSED",
        })
        write_summary(output_directory / "summary.json", summary)
        print(
            f"CodeScene Code Health: PASSED - analysed {len(analysed)} changed files; "
            "the CLI returned no new findings"
        )
        return 0
    try:
        result_data = json.loads(raw_output)
    except json.JSONDecodeError:
        result_data = None
    if result_data is None:
        summary["reason"] = (
            "CodeScene CLI failed or returned malformed JSON; inspect diagnostic.txt."
        )
        write_summary(output_directory / "summary.json", summary)
        print(f"CodeScene Code Health: UNAVAILABLE - {summary['reason']}")
        return 1 if strict else 0

    degradation = find_value(
        result_data, {"degrades-in-code-health", "degrades_in_code_health"}
    )
    violates_goal = find_value(result_data, {"violates-goal", "violates_goal"})
    gate_failed = result.returncode != 0 or degradation is True or violates_goal is True
    summary.update({
        "analysis_link": analysis_link(result_data),
        "code_health_degradation": (
            "YES" if degradation is True else "NO" if degradation is False else "UNKNOWN"
        ),
        "quality_gate": "FAILED" if gate_failed else "PASSED",
        "reason": "CodeScene CLI delta analysis completed.",
        "status": "FAILED" if gate_failed else "PASSED",
    })
    write_summary(output_directory / "summary.json", summary)
    print(
        f"CodeScene Code Health: {summary['status']} - analysed {len(analysed)} changed files; "
        f"degradation={summary['code_health_degradation']}; gate={summary['quality_gate']}"
    )
    return 1 if strict and gate_failed else 0


def main() -> int:
    """Validate configuration or execute the CI delta-analysis policy."""

    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("validate-config", "analyze"))
    arguments = parser.parse_args()
    try:
        root = repository_root()
        configuration = load_configuration(root)
        if arguments.command == "validate-config":
            print("CodeScene project configuration validated")
            return 0
        return analyze(root, configuration)
    except (OSError, ValueError, XWalkCodeHealthError) as error:
        print(f"CodeScene Code Health configuration error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
