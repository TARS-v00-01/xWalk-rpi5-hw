#!/usr/bin/env python3
"""Validate repository-owned xWalk Zuul job structure and playbook references."""

from __future__ import annotations

import argparse
from pathlib import Path
from typing import Any

import yaml


class XWalkZuulValidationError(Exception):
    """Report one invalid repository-controlled Zuul configuration."""


def job_name(entry: object) -> str:
    """Return one project-pipeline job name from its supported YAML form."""
    if isinstance(entry, str) and entry:
        return entry
    if isinstance(entry, dict) and len(entry) == 1:
        name = next(iter(entry))
        if isinstance(name, str) and name:
            return name
    raise XWalkZuulValidationError("project pipelines must contain named jobs")


def validate_dependencies(jobs: dict[str, dict[str, Any]]) -> None:
    """Reject unknown dependencies and dependency cycles."""
    for name, job in jobs.items():
        dependencies = job.get("dependencies", [])
        if not isinstance(dependencies, list) or not all(
            isinstance(dependency, str) for dependency in dependencies
        ):
            raise XWalkZuulValidationError(f"{name} has invalid dependencies")
        unknown = sorted(set(dependencies) - set(jobs))
        if unknown:
            raise XWalkZuulValidationError(
                f"{name} references unknown dependencies: {', '.join(unknown)}"
            )

    visiting: set[str] = set()
    visited: set[str] = set()

    def visit(name: str) -> None:
        if name in visiting:
            raise XWalkZuulValidationError(f"dependency cycle includes {name}")
        if name in visited:
            return
        visiting.add(name)
        for dependency in jobs[name].get("dependencies", []):
            visit(dependency)
        visiting.remove(name)
        visited.add(name)

    for name in jobs:
        visit(name)


def validate_playbooks(repository_root: Path, jobs: dict[str, dict[str, Any]]) -> None:
    """Require every job to reference existing run and optional post-run playbooks."""
    for name, job in jobs.items():
        run = job.get("run")
        if not isinstance(run, str) or not run:
            raise XWalkZuulValidationError(f"{name} does not define a run playbook")
        for key in ("run", "post-run"):
            value = job.get(key)
            if value is None:
                continue
            if not isinstance(value, str) or not value:
                raise XWalkZuulValidationError(f"{name} has an invalid {key} value")
            path = repository_root / value
            if not path.is_file():
                raise XWalkZuulValidationError(f"{name} references missing {key}: {value}")


def validate_pipelines(
    projects: list[dict[str, Any]], jobs: dict[str, dict[str, Any]]
) -> None:
    """Require check and gate to register every defined xWalk job exactly once."""
    if len(projects) != 1:
        raise XWalkZuulValidationError("configuration must define exactly one project entry")
    project = projects[0]
    expected = set(jobs)
    for pipeline in ("check", "gate"):
        pipeline_value = project.get(pipeline)
        if not isinstance(pipeline_value, dict):
            raise XWalkZuulValidationError(f"project does not define {pipeline}")
        entries = pipeline_value.get("jobs")
        if not isinstance(entries, list):
            raise XWalkZuulValidationError(f"{pipeline} does not define a job list")
        names = [job_name(entry) for entry in entries]
        if len(names) != len(set(names)):
            raise XWalkZuulValidationError(f"{pipeline} contains duplicate jobs")
        missing = sorted(expected - set(names))
        unknown = sorted(set(names) - expected)
        if missing or unknown:
            details = []
            if missing:
                details.append(f"missing: {', '.join(missing)}")
            if unknown:
                details.append(f"unknown: {', '.join(unknown)}")
            raise XWalkZuulValidationError(f"{pipeline} jobs differ ({'; '.join(details)})")


def validate(configuration_path: Path) -> None:
    """Validate the complete repository-owned Zuul configuration."""
    try:
        content = yaml.safe_load(configuration_path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as error:
        raise XWalkZuulValidationError(f"cannot parse {configuration_path}: {error}") from error
    if not isinstance(content, list):
        raise XWalkZuulValidationError("Zuul configuration root must be a list")

    jobs: dict[str, dict[str, Any]] = {}
    projects: list[dict[str, Any]] = []
    for item in content:
        if not isinstance(item, dict) or len(item) != 1:
            raise XWalkZuulValidationError("each Zuul item must contain one configuration type")
        if "job" in item:
            job = item["job"]
            if not isinstance(job, dict) or not isinstance(job.get("name"), str):
                raise XWalkZuulValidationError("every job must have a string name")
            name = job["name"]
            if name in jobs:
                raise XWalkZuulValidationError(f"duplicate job: {name}")
            jobs[name] = job
        elif "project" in item:
            project = item["project"]
            if not isinstance(project, dict):
                raise XWalkZuulValidationError("project entry must be a mapping")
            projects.append(project)
        elif "nodeset" not in item:
            raise XWalkZuulValidationError(f"unsupported Zuul item: {next(iter(item))}")

    if not jobs:
        raise XWalkZuulValidationError("configuration does not define jobs")
    validate_dependencies(jobs)
    validate_playbooks(configuration_path.parent.resolve(), jobs)
    validate_pipelines(projects, jobs)


def main() -> int:
    """Parse arguments, validate metadata, and return a shell-compatible status."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("configuration", nargs="?", default=".zuul.yaml", type=Path)
    arguments = parser.parse_args()
    try:
        validate(arguments.configuration.resolve())
    except XWalkZuulValidationError as error:
        print(f"Zuul validation failed: {error}")
        return 1
    print("xWalk Zuul structural validation passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
