#!/usr/bin/env bash

set -u

tool_directory="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
fallback_configuration="$tool_directory/.clang-format"
clang_format_command="${XWALK_CLANG_FORMAT:-clang-format}"
discovered_count=0
processed_count=0
passed_count=0
failed_count=0
temporary_files=()
configuration_boundary="$tool_directory"

usage()
{
    cat <<'EOF'
Usage:
  xWalkStyler format [directory]
  xWalkStyler check [directory]
  xWalkStyler format-file <file>
  xWalkStyler check-file <file>
  xWalkStyler --help
EOF
}

summary()
{
    printf 'Styler summary: discovered=%d processed=%d passed=%d failed=%d\n' \
        "$discovered_count" "$processed_count" "$passed_count" "$failed_count"
}

cleanup()
{
    local temporary_file
    for temporary_file in "${temporary_files[@]}"
    do
        rm -f -- "$temporary_file"
    done
}

trap cleanup EXIT HUP INT TERM

fail_usage()
{
    printf 'Error: %s\n' "$1" >&2
    usage >&2
    exit 2
}

require_clang_format()
{
    if ! command -v "$clang_format_command" >/dev/null 2>&1
    then
        printf 'Error: clang-format is unavailable: %s\n' "$clang_format_command" >&2
        summary >&2
        exit 2
    fi
    if [[ ! -r "$fallback_configuration" ]]
    then
        printf 'Error: fallback configuration is unreadable: %s\n' "$fallback_configuration" >&2
        summary >&2
        exit 2
    fi
}

canonical_path()
{
    realpath -e -- "$1" 2>/dev/null
}

is_cpp_file()
{
    case "$1" in
        *.cpp|*.cc|*.cxx|*.h|*.hpp|*.hxx) return 0 ;;
        *) return 1 ;;
    esac
}

is_excluded_path()
{
    case "$1" in
        */.git/*|*/build/*|*/Build/*|*/build-*/*|*/cmake-build-*/*|*/third_party/*|*/external/*|*/vendor/*|\
        */auto-gen/*|*/generated/*|*/xWalkLibrary/x86_64/*|*/xWalkLibrary/aarch64/*)
            return 0
            ;;
        *) return 1 ;;
    esac
}

validate_directory()
{
    local requested="$1"
    local resolved
    if ! resolved="$(canonical_path "$requested")" || [[ ! -d "$resolved" ]]
    then
        printf 'Error: directory does not exist: %s\n' "$requested" >&2
        return 1
    fi
    if [[ ! -r "$resolved" || ! -x "$resolved" ]]
    then
        printf 'Error: directory is not readable: %s\n' "$requested" >&2
        return 1
    fi
    printf '%s\n' "$resolved"
}

validate_file()
{
    local requested="$1"
    local mode="$2"
    local resolved
    if ! resolved="$(canonical_path "$requested")" || [[ ! -f "$resolved" ]]
    then
        printf 'Error: file does not exist: %s\n' "$requested" >&2
        return 1
    fi
    if ! is_cpp_file "$resolved"
    then
        printf 'Error: unsupported C++ file extension: %s\n' "$requested" >&2
        return 1
    fi
    if is_excluded_path "$resolved"
    then
        printf 'Error: excluded source path: %s\n' "$requested" >&2
        return 1
    fi
    if [[ ! -r "$resolved" ]]
    then
        printf 'Error: file is not readable: %s\n' "$requested" >&2
        return 1
    fi
    if [[ "$mode" == "format" && ! -w "$resolved" ]]
    then
        printf 'Error: file is not writable: %s\n' "$requested" >&2
        return 1
    fi
    printf '%s\n' "$resolved"
}

nearest_configuration()
{
    local current
    current="$(dirname -- "$1")"
    while true
    do
        if [[ -r "$current/.clang-format" ]]
        then
            printf '%s\n' "$current/.clang-format"
            return 0
        fi
        if [[ -r "$current/_clang-format" ]]
        then
            printf '%s\n' "$current/_clang-format"
            return 0
        fi
        if [[ "$current" == "$configuration_boundary" || "$current" == "/" ]]
        then
            break
        fi
        current="$(dirname -- "$current")"
    done
    printf '%s\n' "$fallback_configuration"
}

resolve_configuration_boundary()
{
    local start="$1"
    local git_root
    if git_root="$(git -C "$start" rev-parse --show-toplevel 2>/dev/null)"
    then
        canonical_path "$git_root"
    else
        canonical_path "$start"
    fi
}

discover_files()
{
    local directory="$1"
    find "$directory" \
        \( -type d \( -name .git -o -name build -o -name Build -o -name 'build-*' -o \
        -name 'cmake-build-*' -o -name third_party -o -name external -o -name vendor -o \
        -name auto-gen -o -name generated -o -path '*/xWalkLibrary/x86_64' -o \
        -path '*/xWalkLibrary/aarch64' \) -prune \) -o \
        \( -type f \( -name '*.cpp' -o -name '*.cc' -o -name '*.cxx' -o -name '*.h' -o \
        -name '*.hpp' -o -name '*.hxx' \) -print0 \)
}

has_tabs()
{
    LC_ALL=C grep -q $'\t' -- "$1"
}

has_long_lines()
{
    LC_ALL=C awk 'length($0) > 120 { found = 1; exit } END { exit !found }' "$1"
}

check_one_file()
{
    local file="$1"
    local configuration
    local formatted
    local violated=false
    configuration="$(nearest_configuration "$file")"
    formatted="$(mktemp)" || return 2
    temporary_files+=("$formatted")
    if ! "$clang_format_command" --style="file:$configuration" -- "$file" >"$formatted"
    then
        printf 'FAIL %s (clang-format error)\n' "$file"
        return 1
    fi
    if ! cmp -s -- "$file" "$formatted"
    then
        violated=true
    fi
    if has_tabs "$file" || has_long_lines "$file"
    then
        violated=true
    fi
    if [[ "$violated" == true ]]
    then
        printf 'FAIL %s\n' "$file"
        return 1
    fi
    return 0
}

format_one_file()
{
    local file="$1"
    local configuration
    configuration="$(nearest_configuration "$file")"
    if ! "$clang_format_command" --style="file:$configuration" -i -- "$file"
    then
        printf 'FAIL %s (clang-format error)\n' "$file"
        return 1
    fi
    if has_tabs "$file" || has_long_lines "$file"
    then
        printf 'FAIL %s (tab or line-length violation remains)\n' "$file"
        return 1
    fi
    return 0
}

process_files()
{
    local mode="$1"
    shift
    local file
    for file in "$@"
    do
        ((processed_count += 1))
        if [[ "$mode" == "format" ]]
        then
            if format_one_file "$file"
            then
                ((passed_count += 1))
            else
                ((failed_count += 1))
            fi
        elif check_one_file "$file"
        then
            ((passed_count += 1))
        else
            ((failed_count += 1))
        fi
    done
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]
then
    [[ "$#" -eq 1 ]] || fail_usage "--help does not accept arguments"
    usage
    exit 0
fi

[[ "$#" -ge 1 ]] || fail_usage "a command is required"
command_name="$1"
shift
require_clang_format

case "$command_name" in
    format|check)
        [[ "$#" -le 1 ]] || fail_usage "$command_name accepts at most one directory"
        requested_directory="${1:-}"
        if [[ -z "$requested_directory" ]]
        then
            if ! requested_directory="$(git -C "$tool_directory" rev-parse --show-toplevel 2>/dev/null)"
            then
                printf 'Error: unable to determine the Git repository root\n' >&2
                summary >&2
                exit 2
            fi
        fi
        if ! directory="$(validate_directory "$requested_directory")"
        then
            summary >&2
            exit 2
        fi
        configuration_boundary="$(resolve_configuration_boundary "$directory")"
        files=()
        while IFS= read -r -d '' file
        do
            files+=("$file")
        done < <(discover_files "$directory" | sort -z)
        discovered_count="${#files[@]}"
        process_files "$command_name" "${files[@]}"
        ;;
    format-file|check-file)
        [[ "$#" -eq 1 ]] || fail_usage "$command_name requires exactly one file"
        mode="${command_name%-file}"
        if ! file="$(validate_file "$1" "$mode")"
        then
            summary >&2
            exit 2
        fi
        configuration_boundary="$(resolve_configuration_boundary "$(dirname -- "$file")")"
        discovered_count=1
        process_files "$mode" "$file"
        ;;
    *) fail_usage "unknown command: $command_name" ;;
esac

summary
[[ "$failed_count" -eq 0 ]]
