# Generated by setup-rpi.sh for the exact devices selected during provisioning.
# Debian/Raspberry Pi OS default groups do not consistently cover custom-selected bus nodes.
# Each rule matches one configured kernel node; audio and video keep distribution-owned rules.
SUBSYSTEM=="i2c-dev", KERNEL=="@I2C_KERNEL@", GROUP="i2c", MODE="0660"
SUBSYSTEM=="gpio", KERNEL=="@GPIO_KERNEL@", GROUP="gpio", MODE="0660"
SUBSYSTEM=="spidev", KERNEL=="@SPI_KERNEL@", GROUP="spi", MODE="0660"
