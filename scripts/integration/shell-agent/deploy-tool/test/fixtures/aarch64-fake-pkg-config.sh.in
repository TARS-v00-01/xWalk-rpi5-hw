#!/usr/bin/env bash

set -eu

sysroot="@SYSROOT@"
mode="@MODE@"
operation="$1"
module_name="$2"

if [ "$operation" = "--exists" ]; then
    if [ "$mode" = "missing" ] && [ "$module_name" = "protobuf" ]; then
        exit 1
    fi
    exit 0
fi
if [ "$operation" = "--variable=pcfiledir" ]; then
    if [ "$mode" = "contaminated" ] && [ "$module_name" = "protobuf" ]; then
        echo "/usr/lib/x86_64-linux-gnu/pkgconfig"
    else
        echo "$sysroot/usr/lib/aarch64-linux-gnu/pkgconfig"
    fi
    exit 0
fi
if [ "$operation" = "--libs-only-L" ]; then
    if [ "$mode" = "wrong_arch" ] && [ "$module_name" = "protobuf" ]; then
        echo "-L$sysroot/usr/lib"
    fi
    exit 0
fi
if [ "$operation" = "--libs-only-l" ]; then
    if [ "$mode" = "wrong_arch" ] && [ "$module_name" = "protobuf" ]; then
        echo "-lhostfake"
    fi
    exit 0
fi

echo "Unsupported fake pkg-config operation: $operation" >&2
exit 64
