[Unit]
Description=xWalk local Jarvis voice controller
Requires=ollama.service
After=ollama.service sound.target

[Service]
Type=simple
ExecStart=/usr/bin/xwalk-picarx-control --deployment-config /var/lib/xwalk/picar-x.conf voice-active-car-gpt start
WorkingDirectory=/var/lib/xwalk
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
KillSignal=SIGTERM

[Install]
WantedBy=default.target
