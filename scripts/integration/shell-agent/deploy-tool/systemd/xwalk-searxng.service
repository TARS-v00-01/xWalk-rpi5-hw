[Unit]
Description=xWalk optional loopback SearXNG service
After=network-online.target podman.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=%h/.config/xwalk/searxng.env
ExecStart=/usr/bin/podman compose -f %h/.local/share/xwalk/searxng/compose.yaml up -d
ExecStop=/usr/bin/podman compose -f %h/.local/share/xwalk/searxng/compose.yaml down
TimeoutStartSec=180
TimeoutStopSec=30

[Install]
WantedBy=default.target
